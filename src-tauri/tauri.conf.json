{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "kore_companion",
  "version": "0.1.0",
  "identifier": "com.m6.korecompanion",

  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["kore"]
      }
    }
  },

  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },

  "app": {
    "windows": [
      {
        "title": "K.O.R.E. Companion",
        "width": 900,
        "height": 700
      }
    ],
    "security": {
      "csp": null
    }
  },

  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "infoPlist": "Info.plist",
      "entitlements": "Entitlements.plist"
    }
  }
}